    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_MON_PROMETHEUS}"
      },
      "description": "Empfangene und gesendete Bits pro Sekunde. Die Messreihen dieses Anschlusses sind getrennt dargestellt.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 0,
            "lineWidth": 2,
            "spanNulls": false
          },
          "min": 0,
          "noValue": "Keine Daten",
          "unit": "bps"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Empfangen"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "#5794F2",
                  "mode": "fixed"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Senden"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "#56A64B",
                  "mode": "fixed"
                }
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "id": 21,
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_MON_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "max by (interface) (rate(net_bytes_recv{job=\"telegraf-dashboard\",host=\"dashboard\",interface=\"ens18\"}[5m]) * 8)",
          "instant": false,
          "legendFormat": "Empfangen",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_MON_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "max by (interface) (rate(net_bytes_sent{job=\"telegraf-dashboard\",host=\"dashboard\",interface=\"ens18\"}[5m]) * 8)",
          "instant": false,
          "legendFormat": "Senden",
          "range": true,
          "refId": "B"
        }
      ],
